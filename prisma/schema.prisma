generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Espaço financeiro isolado do usuário (ex.: "Pessoal", "Trabalho"). Toda
/// tabela de Finanças/Investimentos pertence a exatamente uma conta, que por
/// sua vez pertence a um único usuário. Limite de 2 por usuário, aplicado em
/// app/actions/contas-financeiras.ts (não há constraint de banco para isso).
model ContaFinanceira {
  id       String   @id @default(cuid())
  userId   String
  nome     String
  cor      String   @default("#6B96D6")
  padrao   Boolean  @default(false)
  criadoEm DateTime @default(now())

  accounts            Account[]
  categories          Category[]
  cards               Card[]
  transactions        Transaction[]
  subscriptions       Subscription[]
  assets              Asset[]
  assetMovements      AssetMovement[]
  metasPoupanca       MetaPoupanca[]

  @@index([userId])
}

model Account {
  id                String          @id @default(cuid())
  userId            String
  contaFinanceiraId String
  nome              String
  tipo              String
  cor               String
  saldoInicial      Int             @default(0)
  criadoEm          DateTime        @default(now())
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([userId])
  @@index([contaFinanceiraId])
}

model Category {
  id                String          @id @default(cuid())
  userId            String
  contaFinanceiraId String
  nome              String
  emoji             String
  cor               String
  tipo              String
  orcamentoMensal   Int?
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([userId])
  @@index([contaFinanceiraId])
}

model Card {
  id                String          @id @default(cuid())
  userId            String
  contaFinanceiraId String
  nome              String
  bandeira          String
  // slug da instituição emissora (ex.: "nubank", "inter") — usado para achar o
  // logo em public/brand/bancos/; null cai no fallback de inicial colorida.
  instituicao       String?
  tipo              String          @default("credito")
  limite            Int?
  fechamento        Int
  vencimento        Int
  cor               String          @default("#6B96D6")
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([userId])
  @@index([contaFinanceiraId])
}

model Transaction {
  id                String          @id @default(cuid())
  userId            String
  contaFinanceiraId String
  tipo              String
  // "despesa" | "compromisso" — compromisso é um lançamento tipo="despesa" que
  // representa um comprometimento recorrente (ex.: aporte mensal fixo) e por
  // isso fica de fora dos totais/gráficos de gasto, mas aparece na listagem.
  natureza          String          @default("despesa")
  valor             Int
  data              DateTime
  descricao         String
  tags              String          @default("[]")
  recorrente        Boolean         @default(false)
  parcelaGrupo      String?
  parcelaNum        Int?
  parcelaTotal      Int?
  paga              Boolean         @default(true)
  accountId         String?
  categoryId        String?
  cardId            String?
  // LEGADO: transferências antigas guardavam a conta de destino aqui. Mantido
  // só para preservar histórico não migrado; ver prisma/backfill-transferencias.ts.
  // Código novo usa origemTipo/origemId/destinoTipo/destinoId.
  contraAccountId   String?
  // Ponta de origem/destino de uma transferência: "conta" | "cartao" | "ativo".
  // Sem FK (mesmo padrão de contraAccountId) — ponta apontando p/ registro já
  // excluído degrada para null na leitura, em vez de quebrar.
  origemTipo        String?
  origemId          String?
  destinoTipo       String?
  destinoId         String?
  criadoEm          DateTime        @default(now())
  account           Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  card              Card?           @relation(fields: [cardId], references: [id])
  category          Category?       @relation(fields: [categoryId], references: [id])
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)

  @@index([userId, data])
  @@index([userId, parcelaGrupo])
  @@index([categoryId])
  @@index([accountId])
  @@index([cardId])
  @@index([origemTipo, origemId])
  @@index([destinoTipo, destinoId])
  @@index([contaFinanceiraId])
}

model Subscription {
  id                String          @id @default(cuid())
  userId            String
  contaFinanceiraId String
  nome              String
  emoji             String          @default("💳")
  valor             Int
  diaCobranca       Int
  status            String          @default("ativa")
  criadoEm          DateTime        @default(now())
  valorAnterior     Int?
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contaFinanceiraId])
}

model MetaPoupanca {
  id                String                    @id @default(cuid())
  userId            String
  contaFinanceiraId String
  nome              String
  emoji             String
  descricao         String?
  valorAlvo         Int
  valorAtual        Int                       @default(0)
  concluida         Boolean                   @default(false)
  criadoEm          DateTime                  @default(now())
  contaFinanceira   ContaFinanceira           @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)
  contribuicoes     MetaPoupancaContribuicao[]

  @@index([userId])
  @@index([contaFinanceiraId])
  @@index([userId, concluida])
}

model MetaPoupancaContribuicao {
  id              String         @id @default(cuid())
  userId          String
  metaPoupancaId  String
  valor           Int
  fonte           String         // "receita" | "investimento" | "cartao" | "conta" | "manual"
  fonteId         String?        // id do investimento/cartao/conta/categoria, quando aplicável
  descricao       String?
  transactionId   String?        // transaction criada quando fonte="cartao" ou "conta"
  assetMovementId String?        // assetMovement criado quando fonte="investimento"
  criadoEm        DateTime       @default(now())
  metaPoupanca    MetaPoupanca   @relation(fields: [metaPoupancaId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([metaPoupancaId])
  @@index([criadoEm])
  @@index([fonte, fonteId])
}

model Asset {
  id                String          @id @default(cuid())
  userId            String
  contaFinanceiraId String
  nome              String
  classe            String
  instituicao       String
  cor               String
  diaAporte         Int? // dia do mês (1-31) para lembrete de aporte recorrente
  revisarACada      Int? // dias entre revisões de valor (7, 15 ou 30)
  proximaRevisao    DateTime? // próxima data em que o valor deve ser atualizado
  criadoEm          DateTime        @default(now())
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)
  movements         AssetMovement[]

  @@index([userId])
  @@index([proximaRevisao])
  @@index([contaFinanceiraId])
}

model AssetMovement {
  id                String          @id @default(cuid())
  userId            String
  contaFinanceiraId String
  tipo              String
  valor             Int
  data              DateTime
  nota              String?
  assetId           String
  // Preenchido quando o movimento nasceu de uma transferência em Finanças
  // (Transaction.origemTipo/destinoTipo === "ativo"). Sem FK — mesmo padrão
  // de degradação usado no restante do schema.
  transactionId     String?
  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)

  @@index([userId, data])
  @@index([assetId])
  @@index([transactionId])
  @@index([contaFinanceiraId])
}

model Food {
  id         String     @id @default(cuid())
  userId     String
  nome       String
  kcal100    Float?
  prot100    Float?
  carb100    Float?
  gord100    Float?
  porcaoNome String?
  porcaoG    Float?
  mealItems  MealItem[]

  @@index([userId])
}

model Diet {
  id       String  @id @default(cuid())
  userId   String
  nome     String
  ativa    Boolean @default(false)
  metaKcal Int     @default(2200)
  metaProt Int     @default(160)
  metaCarb Int     @default(220)
  metaGord Int     @default(60)
  meals    Meal[]

  @@index([userId])
}

model Meal {
  id      String       @id @default(cuid())
  userId  String
  nome    String
  horario String?
  ordem   Int          @default(0)
  dietId  String
  diet    Diet         @relation(fields: [dietId], references: [id], onDelete: Cascade)
  items   MealItem[] // itens "soltos" (pré-opções) — migrados p/ options no backfill
  options MealOption[] // no máx. 4 por refeição (validado na action)

  @@index([userId])
  @@index([dietId])
}

// Opção de uma refeição: "Opção A/B/C" com sua própria lista de alimentos.
// No check-in do dia o usuário escolhe qual opção comeu (DietDayLog.escolhas).
model MealOption {
  id     String     @id @default(cuid())
  userId String
  nome   String
  ordem  Int        @default(0)
  mealId String
  meal   Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  items  MealItem[]

  @@index([userId])
  @@index([mealId])
}

model MealItem {
  id         String      @id @default(cuid())
  userId     String
  quantidade Float
  unidade    String      @default("g")
  mealId     String
  foodId     String
  optionId   String? // opção a que o item pertence (null = legado pré-backfill)
  food       Food        @relation(fields: [foodId], references: [id], onDelete: Cascade)
  meal       Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  option     MealOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mealId])
  @@index([foodId])
  @@index([optionId])
}

model DietDayLog {
  id                 String   @id @default(cuid())
  userId             String
  data               DateTime
  refeicoesCumpridas String   @default("[]")
  escolhas           String   @default("[]") // [{mealId, optionId}] — opção comida no dia
  extras             String   @default("[]")
  aguaMl             Int      @default(0)
  notas              String?

  @@unique([userId, data])
}

model WeightLog {
  id                 String   @id @default(cuid())
  userId             String
  data               DateTime
  pesoKg             Float
  cintura            Float?
  braco              Float?
  // Principais (bioimpedância básica)
  percentualGordura  Float?
  massaMuscular      Float?
  // Opcionais (bioimpedância completa) — a maioria não faz exame com esses dados
  aguaCorporal       Float?
  massaOssea         Float?
  gorduraVisceral    Float?
  tmb                Int?

  @@index([userId, data])
}

model Routine {
  id         String            @id @default(cuid())
  userId     String
  nome       String
  foco       String?
  ordem      Int               @default(0)
  diasSemana String            @default("[]") // ["1","3"] = seg,qua (0=dom..6=sáb)
  exercises  RoutineExercise[]
  sessions   WorkoutSession[]

  @@index([userId])
}

model RoutineExercise {
  id            String                @id @default(cuid())
  userId        String
  nome          String
  grupoMuscular String
  // tipoAlvo="series" (padrão): usa series/repsAlvo/cargaAtual abaixo.
  // tipoAlvo="tempo": bloco cronometrado (aquecimento/alongamento), sem
  // séries/reps/carga — usa tempoAlvoSeg. series/repsAlvo/cargaAtual = config
  // da SEMANA-BASE (semana 1). As semanas seguintes herdam a última editada;
  // overrides vivem em RoutineWeekExercise.
  tipoAlvo      String                @default("series")
  series        Int
  repsAlvo      String
  cargaAtual    Float                 @default(0)
  tempoAlvoSeg  Int                   @default(60)
  descansoSeg   Int                   @default(90)
  observacao    String?
  ordem         Int                   @default(0)
  routineId     String
  metodo        String                @default("Nenhum")
  routine       Routine               @relation(fields: [routineId], references: [id], onDelete: Cascade)
  setLogs       SetLog[]
  weeks         RoutineWeekExercise[]

  @@index([userId])
  @@index([routineId])
}

// Override de um exercício numa semana específica do ciclo. Só existe linha nas
// semanas que o usuário editou; a config efetiva da semana N é o override da
// maior semana <= N que existir, senão o valor base do RoutineExercise.
model RoutineWeekExercise {
  id         String          @id @default(cuid())
  userId     String
  exerciseId String
  semana     Int // 1, 2, 3... (índice da semana no ciclo)
  series     Int
  repsAlvo   String
  cargaAtual Float           @default(0)
  exercise   RoutineExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, semana])
  @@index([userId])
  @@index([exerciseId])
}

model WorkoutSession {
  id         String   @id @default(cuid())
  userId     String
  data       DateTime
  duracaoMin Int      @default(0)
  concluida  Boolean  @default(true)
  notas      String?
  routineId  String?
  setLogs    SetLog[]
  routine    Routine? @relation(fields: [routineId], references: [id])

  @@index([userId, data])
  @@index([routineId])
}

model SetLog {
  id         String          @id @default(cuid())
  userId     String
  serie      Int
  reps       Int
  cargaKg    Float
  sessionId  String
  exerciseId String
  exercise   RoutineExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  session    WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
  @@index([sessionId])
}

model Run {
  id               String      @id @default(cuid())
  userId           String
  data             DateTime
  km               Float
  segundos         Int
  tipo             String
  sensacao         Int         @default(3)
  notas            String?
  // planId: vínculo LEGADO ao antigo RunPlan (removido). Mantido só como coluna
  // para preservar o histórico; não há mais relação. runSessionId é o novo elo.
  planId           String?
  runSessionId     String? // qual sessão do plano (RunSession) esta corrida cumpriu
  stravaActivityId String? // id da atividade no Strava (evita duplicar na sync)
  stravaLink       String? // URL da atividade no Strava
  runSession       RunSession? @relation(fields: [runSessionId], references: [id], onDelete: SetNull)

  @@unique([userId, stravaActivityId])
  @@index([userId, data])
  @@index([runSessionId])
}

// Plano nomeado de corrida (espelha Routine): "Base 5k", com dias da semana e
// sessões dentro. Substitui o antigo RunPlan (linhas soltas por dia).
model RunRoutine {
  id         String       @id @default(cuid())
  userId     String
  nome       String
  foco       String?
  diasSemana String       @default("[]") // ["2","4","6"] (0=dom..6=sáb)
  ordem      Int          @default(0)
  criadoEm   DateTime     @default(now())
  sessions   RunSession[]

  @@index([userId])
}

// Sessão de um plano de corrida (espelha RoutineExercise): "Longão de domingo",
// tipo + km-alvo da SEMANA-BASE. Semanas seguintes herdam via RunSessionWeek.
model RunSession {
  id              String           @id @default(cuid())
  userId          String
  nome            String
  tipo            String // "Leve" | "Moderado" | "Intervalado" | "Longão"
  kmAlvo          Float
  paceAlvoSeg     Int? // opcional, seg/km — reservado p/ futuro
  ordem           Int              @default(0)
  routineId       String
  routine         RunRoutine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  weeks           RunSessionWeek[]
  runs            Run[]
  rotinaTemplates RotinaTemplate[]

  @@index([userId])
  @@index([routineId])
}

// Override de km numa semana do ciclo (espelha RoutineWeekExercise). Só existe
// linha nas semanas editadas; a config efetiva da semana N segue weekConfig().
model RunSessionWeek {
  id        String     @id @default(cuid())
  userId    String
  sessionId String
  semana    Int // 1, 2, 3... (índice da semana no ciclo)
  kmAlvo    Float
  session   RunSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, semana])
  @@index([userId])
  @@index([sessionId])
}

// Tokens OAuth do Strava por usuário — nunca expostos ao client.
model StravaAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  athleteId    String?
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  criadoEm     DateTime @default(now())
}

// Categoria reutilizável de estudo (Inglês, Trabalho extra, Cálculo...).
// É a "variável" compartilhada: o cronômetro estuda uma categoria e o item do
// checklist (PlanItem) aponta para a mesma, ligando plano ↔ tempo executado.
model StudyCategory {
  id              String           @id @default(cuid())
  userId          String
  nome            String
  emoji           String           @default("📚")
  cor             String           @default("#6B96D6")
  ordem           Int              @default(0)
  ativo           Boolean          @default(true)
  criadoEm        DateTime         @default(now())
  sessions        StudySession[]
  rotinaTemplates RotinaTemplate[]

  @@index([userId])
}

model StudySession {
  id            String         @id @default(cuid())
  userId        String
  subject       String
  startedAt     DateTime
  endedAt       DateTime?
  totalSeconds  Int            @default(0)
  netSeconds    Int            @default(0)
  targetMinutes Int?
  rating        Int            @default(0)
  notes         String?
  createdAt     DateTime       @default(now())
  categoryId    String?
  category      StudyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  marks         StudyMark[]
  pauses        StudyPause[]

  @@index([userId, startedAt])
  @@index([categoryId])
}

model StudyPause {
  id          String       @id @default(cuid())
  userId      String
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int          @default(0)
  label       String?
  sessionId   String
  session     StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model StudyMark {
  id        String       @id @default(cuid())
  userId    String
  timestamp DateTime
  label     String
  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model Calendar {
  id       String  @id @default(cuid())
  userId   String
  nome     String
  cor      String
  readonly Boolean @default(false)
  visivel  Boolean @default(true)
  ordem    Int     @default(0)
  // Google Calendar integration
  googleId String? // ID do calendário no Google (ex: "primary" ou email)
  sincronizado Boolean @default(false)
  events   Event[]

  @@index([userId])
  @@index([googleId])
}

model GoogleIntegration {
  id           String  @id @default(cuid())
  userId       String  @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  escopo       String  @default("calendar")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([userId])
}

model Event {
  id          String      @id @default(cuid())
  userId      String
  titulo      String
  inicio      DateTime
  fim         DateTime
  diaInteiro  Boolean     @default(false)
  rrule       String?
  exdates     String      @default("[]")
  local       String?
  descricao   String?
  tags        String      @default("[]")
  lembreteMin Int?
  calendarId  String
  calendar    Calendar    @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  notes       EventNote[]

  @@index([userId, inicio])
  @@index([calendarId])
}

model EventNote {
  id       String   @id @default(cuid())
  userId   String
  texto    String
  criadoEm DateTime @default(now())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
}

model Holiday {
  id   String   @id @default(cuid())
  data DateTime
  nome String
  ano  Int

  @@unique([data, nome])
  @@index([ano])
}

model Goal {
  id     String  @id @default(cuid())
  userId String
  titulo String
  mes    String
  feito  Boolean @default(false)
  ordem  Int     @default(0)

  @@index([userId])
}

// Meta quantitativa (variável): alvo numérico com progresso calculado
// automaticamente a partir de dados de outros módulos (ver metrica).
// chave é a âncora estável do período ("2026-07", "2026-Q3", "2026"),
// no mesmo espírito de Goal.mes — nunca guardamos um Date cru aqui.
model MetaQuantitativa {
  id         String   @id @default(cuid())
  userId     String
  titulo     String
  origem     String   @default("metrica") // "metrica" | "variavel"
  metrica    String? // "treinos" | "km_corridos" | "refeicoes_cumpridas" | "horas_estudo", quando origem="metrica"
  // Variavel do próprio userId quando origem="variavel" — sem FK (vínculo
  // fraco, mesmo padrão de DesafioMeta.rotinaTemplateId): variável excluída
  // degrada o progresso pra zero, não quebra a leitura.
  variavelId String?
  alvo       Float
  periodo    String // "mes" | "trimestre" | "ano"
  chave      String
  ordem      Int      @default(0)
  criadoEm   DateTime @default(now())

  @@index([userId])
  @@index([userId, periodo, chave])
}

/// Lançamento manual de dinheiro ganho (ex.: "ganhei R$500"), em centavos.
/// Fonte única e global do usuário para a métrica "dinheiro" — qualquer
/// MetaQuantitativa ou DesafioMeta com metrica="dinheiro" soma estes
/// lançamentos dentro do período da meta, então um único lançamento reflete
/// automaticamente em todas as metas/desafios que usam essa métrica.
model DinheiroLancamento {
  id        String   @id @default(cuid())
  userId    String
  valor     Int
  descricao String?
  data      DateTime
  criadoEm  DateTime @default(now())

  @@index([userId, data])
}

// Variável pessoal contável, criada livremente pelo usuário (ex.: "Corrida",
// "Sem pornografia"). Aparece no checklist diário ao lado de RotinaTemplate
// (ver lib/data/rotinas.ts + lib/data/variaveis.ts: itensChecklistDoDia), mas
// é um cidadão de primeira classe próprio — permite ser usada como origem de
// progresso tanto em MetaQuantitativa quanto em DesafioMeta (origem="variavel"
// nesses models), o que RotinaTemplate não é desenhado para suportar.
model Variavel {
  id           String   @id @default(cuid())
  userId       String
  nome         String
  emoji        String   @default("🔥")
  cor          String   @default("#6B96D6")
  medeStreak   Boolean  @default(true)
  medeContagem Boolean  @default(true)
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())

  checks VariavelCheckDia[]

  @@index([userId])
  @@index([userId, ativo])
}

// "Feito" de uma variável num dia específico (variavelId + dia). Presença =
// feito, mesmo espírito de RotinaCheckDia. Sem feitoAuto: variável não tem
// execução automática associada — marcação é sempre manual.
model VariavelCheckDia {
  id         String   @id @default(cuid())
  userId     String
  variavelId String
  data       DateTime
  variavel   Variavel @relation(fields: [variavelId], references: [id], onDelete: Cascade)

  @@unique([variavelId, data])
  @@index([userId, data])
}

// Grupo de crescimento colaborativo ("desafio"), estilo Gymrats: cada membro
// cadastra e possui as PRÓPRIAS metas (ver DesafioMeta) — o grupo só dá
// visibilidade cruzada + comparação por %. Dono do desafio é quem cria;
// membros entram via código de convite. metasGrandesLimite é o nº de metas
// grandes que CADA membro pode ter, definido uma vez na criação.
model Desafio {
  id                 String   @id @default(cuid())
  criadorId          String
  nome               String
  descricao          String?
  codigo             String   @unique
  metasGrandesLimite Int      @default(4)
  ativo              Boolean  @default(true)
  criadoEm           DateTime @default(now())

  membros   DesafioMembro[]
  metas     DesafioMeta[]
  mensagens DesafioMensagem[]
  documento DesafioDocumento?

  @@index([criadorId])
}

// Participação de um usuário num desafio (join table com metadado de entrada).
model DesafioMembro {
  id        String   @id @default(cuid())
  desafioId String
  userId    String
  entrouEm  DateTime @default(now())
  desafio   Desafio  @relation(fields: [desafioId], references: [id], onDelete: Cascade)

  @@unique([desafioId, userId])
  @@index([userId])
}

// Meta de UM membro dentro do desafio — grande (metaPaiId=null, até
// Desafio.metasGrandesLimite por userId) ou pequena (metaPaiId setado,
// aponta pra uma grande do MESMO userId). Progresso sempre em % (ver
// lib/data/desafios.ts) pra ser comparável entre membros mesmo quando a
// métrica/conteúdo é diferente. Visível a qualquer membro do mesmo
// desafioId, mas só o dono (userId) pode criar/editar/excluir a própria.
model DesafioMeta {
  id               String   @id @default(cuid())
  desafioId        String
  userId           String
  metaPaiId        String?
  titulo           String
  origem           String // "metrica" | "checklist" | "variavel"
  metrica          String? // MetaMetrica (metas-quantitativas.ts) quando origem="metrica"
  // RotinaTemplate do PRÓPRIO userId quando origem="checklist" — sem FK forte
  // (mesmo padrão de degradação do resto do schema: template excluído no
  // futuro só faz a contagem voltar a zero, não quebra a leitura).
  rotinaTemplateId String?
  // Variavel do PRÓPRIO userId quando origem="variavel" — mesmo padrão de
  // vínculo fraco de rotinaTemplateId acima.
  variavelId       String?
  alvo             Float
  periodo          String // "semana" | "mes" | "trimestre" | "semestre"
  ordem            Int      @default(0)
  criadoEm         DateTime @default(now())

  desafio Desafio       @relation(fields: [desafioId], references: [id], onDelete: Cascade)
  metaPai DesafioMeta?  @relation("DesafioMetaFilhas", fields: [metaPaiId], references: [id], onDelete: Cascade)
  filhas  DesafioMeta[] @relation("DesafioMetaFilhas")

  @@index([desafioId])
  @@index([userId])
  @@index([metaPaiId])
}

// Mensagem no chat de um desafio — visível a qualquer membro, sem edição/exclusão
// (histórico simples, estilo feed de grupo). Lido via polling, não WebSocket.
model DesafioMensagem {
  id        String   @id @default(cuid())
  desafioId String
  userId    String
  texto     String
  criadoEm  DateTime @default(now())

  desafio Desafio @relation(fields: [desafioId], references: [id], onDelete: Cascade)

  @@index([desafioId, criadoEm])
}

// Documento fixado do desafio ("contrato do grupo") — um por desafio,
// substituído a cada novo upload. Arquivo vive no Supabase Storage
// (bucket "desafio-documentos"); aqui só o metadado + URL pública.
model DesafioDocumento {
  id           String   @id @default(cuid())
  desafioId    String   @unique
  nome         String
  arquivoUrl   String
  arquivoTipo  String // mime type (application/pdf, image/png, image/jpeg)
  enviadoPorId String
  criadoEm     DateTime @default(now())

  desafio Desafio @relation(fields: [desafioId], references: [id], onDelete: Cascade)
}

model Setting {
  userId String
  key    String
  value  String

  @@id([userId, key])
}

model Habit {
  id     String  @id @default(cuid())
  userId String
  nome   String
  nota   String? // porquê do hábito — texto livre, exibido ao abrir o card
  ordem  Int     @default(0)
  ativo  Boolean @default(true)

  @@index([userId])
}

model HabitDayLog {
  id          String   @id @default(cuid())
  userId      String
  data        DateTime
  itensFeitos String   @default("[]")

  @@unique([userId, data])
}

// Plano alternativo de rotina nomeado livremente pelo usuário ("Normal", "Dia
// ruim", "Viagem"...). Cada RotinaTemplate pode pertencer a um plano
// específico (planoId setado) ou ser "comum" (planoId=null, aparece em
// qualquer plano escolhido para o dia). A escolha de qual plano vale em cada
// dia fica em RotinaDiaPlano — dias sem escolha explícita usam `padrao`.
model RotinaPlano {
  id       String   @id @default(cuid())
  userId   String
  nome     String
  padrao   Boolean  @default(false) // plano usado quando o dia não tem escolha explícita
  ordem    Int      @default(0)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  templates RotinaTemplate[]
  dias      RotinaDiaPlano[]

  @@index([userId])
  @@index([userId, ativo])
}

// Escolha manual de plano para um dia específico ("hoje foi Plano B"). Linha
// só existe quando o usuário troca o plano padrão naquele dia.
model RotinaDiaPlano {
  id      String      @id @default(cuid())
  userId  String
  data    DateTime // início do dia em SP a que a escolha pertence
  planoId String
  plano   RotinaPlano @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@unique([userId, data])
  @@index([planoId])
}

// Template do checklist diário (o "checklist inteligente"): cadastra-se uma
// vez (nome + janela HH:mm opcional + recorrência + tipo/vínculo opcional com
// uma atividade real) e aparece todo dia que bater a regra, sem duplicar
// linha no banco por dia. Reaproveita o MESMO formato JSON de Event.rrule
// (lib/recurrence.ts) e a MESMA semântica: rrule=null significa ocorrência
// ÚNICA em dataInicio (para "todo dia, para sempre" o rrule é
// {"freq":"daily"} explícito, sem until). Quando o tipo é
// "estudo"/"treino"/"corrida" e o usuário executa a atividade vinculada, a
// ocorrência do dia marca sozinha (RotinaCheckDia.feitoAuto) e — para estudo —
// o progresso de tempo é DERIVADO das sessões do dia, não duplicado aqui.
// horaFim, quando presente, deve ser > horaInicio — não cruza meia-noite na v1.
// planoId=null → item "comum", aparece em qualquer plano ativo no dia.
model RotinaTemplate {
  id         String   @id @default(cuid())
  userId     String
  nome       String
  horaInicio String? // "HH:mm" — opcional; item "livre" pode ficar sem hora
  horaFim    String? // "HH:mm" — só exigido junto com horaInicio
  dataInicio DateTime // início do dia em SP: âncora da recorrência (e do dia único, se rrule=null)
  rrule      String? // mesmo JSON de Rrule (lib/recurrence.ts); null = ocorrência única em dataInicio
  exdates    String   @default("[]") // dayKeys pulados pontualmente ("não fazer hoje")
  ativo      Boolean  @default(true)
  ordem      Int      @default(0)
  criadoEm   DateTime @default(now())

  tipo            String         @default("livre") // "livre" | "estudo" | "treino" | "corrida"
  studyCategoryId String?
  studyCategory   StudyCategory? @relation(fields: [studyCategoryId], references: [id], onDelete: SetNull)
  routineId       String? // tipo "treino" → Routine (musculação)
  runSessionId    String? // tipo "corrida" → RunSession (plano de corrida)
  runSession      RunSession?    @relation(fields: [runSessionId], references: [id], onDelete: SetNull)
  metaMinutos     Int? // meta de tempo p/ estudo/corrida (ex.: 60) — mostra 47/60
  planoId         String? // null = item comum a todos os planos
  plano           RotinaPlano?   @relation(fields: [planoId], references: [id], onDelete: SetNull)

  checks RotinaCheckDia[]

  @@index([userId])
  @@index([userId, ativo])
  @@index([studyCategoryId])
  @@index([routineId])
  @@index([runSessionId])
  @@index([planoId])
}

// "Feito" de uma ocorrência específica (rotinaId + dia). Linha só existe
// quando marcado — presença = feito. feitoAuto distingue "marcado pela
// execução real" de "marcado manualmente" (mostrado como badge "auto" na UI).
// Independente do horário atual do template (editar o horário não reescreve
// histórico).
model RotinaCheckDia {
  id        String         @id @default(cuid())
  userId    String
  rotinaId  String
  data      DateTime // início do dia em SP a que o check pertence
  feitoAuto Boolean        @default(false)
  rotina    RotinaTemplate @relation(fields: [rotinaId], references: [id], onDelete: Cascade)

  @@unique([rotinaId, data])
  @@index([userId, data])
}

/// Descrição/reflexão que o usuário escreve ao concluir 100% do checklist do
/// dia — alimenta o dashboard de histórico (timeline). pct é o snapshot do
/// % de conclusão no momento do registro (o checklist do dia pode mudar depois).
model DiaRegistro {
  id        String   @id @default(cuid())
  userId    String
  data      DateTime // início do dia em SP
  descricao String
  pct       Int
  criadoEm  DateTime @default(now())

  @@unique([userId, data])
  @@index([userId, data])
}

/// Registro PERMANENTE de que o usuário esteve ativo num dia (qualquer ação:
/// check-in, treino, dieta, estudo). Uma vez gravado NÃO é removido — desfazer
/// a ação (ex.: desmarcar um check-in) não apaga o dia da ofensiva. É a fonte
/// de verdade do streak: o foguinho só cai se houver 2 dias seguidos SEM
/// nenhum StreakDia. Grava-se via marcarDiaAtivo() nas server actions.
model StreakDia {
  userId String
  dia    String // dayKey "YYYY-MM-DD" (SP) — estável, não é Date de request
  em     DateTime @default(now())

  @@id([userId, dia])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Profile {
  id        String   @id
  email     String   @unique
  nome      String?
  telefone  String?
  avatarUrl String?
  role      String   @default("user")
  status    String   @default("ativo")
  criadoEm  DateTime @default(now())

  // Lembrete pessoal "atualizar peso/métricas" — mesmo padrão de
  // Asset.revisarACada/proximaRevisao (lib/data/investimentos.ts): intervalo em
  // dias configurado pelo usuário + próxima data calculada e persistida,
  // reagendada automaticamente a cada novo WeightLog.
  revisarPesoACada    Int?
  proximaRevisaoPeso  DateTime?
}
